{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=your_database;Username=your_username;Password=your_password;Include Error Detail=true"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "ModularMonolith.Host"
    }
  },
  "Authentication": {
    "Issuer": "YourApplication",
    "Audience": "YourApplication",
    "Secret": "YOUR_LONG_RANDOM_SECRET_KEY"
  },
