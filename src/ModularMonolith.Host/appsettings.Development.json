{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=modular_monolith_template;Username=postgres;Password=isa123456;Include Error Detail=true"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "ModularMonolith.Host"
    }
  },
  "Authentication": {
    "Issuer": "DeliverySystem",
    "Audience": "DeliverySystem",
    "Secret": "YOUR_LONG_RANDOM_SECRET_KEY"
  }
}
